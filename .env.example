# Supabase
# (también acepta nombres en minúsculas, ej. supabase_service_role_key)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Emails del equipo interno (comma-separated) — acceso a /admin, /bot, /nuevo
ADMIN_EMAILS=tu@email.com

# Anthropic (respuestas del bot)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (embeddings — Anthropic no ofrece embeddings)
OPENAI_API_KEY=sk-...

# Dominio público de la app (para el snippet embebible + OAuth callback)
NEXT_PUBLIC_APP_URL=https://generador-de-bots.vercel.app

# Google Calendar OAuth (Cloud Console → OAuth client Web)
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...

# Resend (emails al confirmar turno)
RESEND_API_KEY=re_...
RESEND_FROM=Turnos <onboarding@resend.dev>

# Opcional: protege el cron de expiración de turnos
CRON_SECRET=una-clave-larga
