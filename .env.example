# Supabase (también acepta MAYÚSCULAS; en Vercel podés usar minúsculas)
next_public_supabase_url=https://xxxx.supabase.co
# anon / publishable (NO la secret/service_role)
next_public_supabase_anon_key=eyJ...
supabase_service_role_key=eyJ...

# Emails del equipo interno (comma-separated) — acceso a /admin, /bot, /nuevo
# Tiene que coincidir con el mail del magic link
admin_emails=candela.caniete1@gmail.com

# Anthropic (respuestas del bot)
anthropic_api_key=sk-ant-...

# OpenAI (embeddings — Anthropic no ofrece embeddings)
openai_api_key=sk-...

# Dominio público de la app (NO uses localhost en Vercel)
next_public_app_url=https://generador-de-bots.vercel.app

# Google Calendar OAuth (Cloud Console → OAuth client Web)
google_client_id=....apps.googleusercontent.com
google_client_secret=...

# Resend — obligatorio para magic link de login + avisos de turnos
resend_api_key=re_...
resend_from=Turnos <onboarding@resend.dev>

# Opcional: protege el cron de expiración de turnos
cron_secret=una-clave-larga
